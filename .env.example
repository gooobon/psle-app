# Copy to .env.local for development. Set the same names in Vercel. Never commit values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ANTHROPIC_API_KEY=

# Supabase server auth (PR: server 1/5). Flag defaults to off.
NEXT_PUBLIC_SERVER_AUTH=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp alerts (Meta Cloud API). OFF by default; no real sends unless WHATSAPP_ENABLED=true. See PR #9 notes.
WHATSAPP_ENABLED=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=
WHATSAPP_API_VERSION=

# Daily parent alert (server 3/5). Sending is OFF unless EMAIL_ALERTS_ENABLED=true (otherwise a dry run is logged).
EMAIL_ALERTS_ENABLED=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
CRON_SECRET=
# Public site origin used for dashboard links in emails, e.g. https://psle-app-vwx3.vercel.app
APP_BASE_URL=

# Parent homework from mistakes (roadmap step 8). OFF by default; also requires NEXT_PUBLIC_SERVER_AUTH=true.
NEXT_PUBLIC_PARENT_HOMEWORK_ENABLED=

# Rewards (step 9): stickers, Saturday weekly review, parent credit ledger. Default off; also needs NEXT_PUBLIC_SERVER_AUTH=true.
NEXT_PUBLIC_REWARDS_ENABLED=

# Chinese mock exams (issue #146). OFF by default; also needs NEXT_PUBLIC_SERVER_AUTH=true and NEXT_PUBLIC_MOCK_EXAMS_ENABLED=true.
# Only papers with sourced per-question marks (src/data/papers/zh_marks.json) are offered.
NEXT_PUBLIC_CHINESE_MOCK_ENABLED=
