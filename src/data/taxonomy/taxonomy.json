  "syllabusNotes": [
    "English leaves follow the MOE Primary English Language Syllabus 2020 grammar and vocabulary items that the PSLE English paper still tests, plus the paper sections (editing, synthesis, visual text, comprehension).",
    "Chinese leaves keep the 14 skill ids already stored on the P3 Higher Chinese bank, grouped under 字 / 拼音 / 词语 / 语法 / 阅读 / 写话. Antonym, idiom, and composition leaves are syllabus neighbours with no items yet.",
    "Mathematics leaves follow the MOE 2021 Primary Mathematics Syllabus content strands (Number and Algebra, Measurement and Geometry, Statistics). Ratio and algebra are the P6 standard sub-strands. Speed is not a separate 2021 topic.",
    "Science leaves follow MOE Primary Science Syllabus 2023 Table 2 (updated Jan 2026): Diversity, Cycles, Systems, Energy, Interactions, from the P3 topic through the P6 topic.",
    "Current question banks are P3 English and P3 Higher Chinese only. Mathematics and Science have no items in this repo yet."
  ],
  "notebookCauses": [
    { "id": "cause.concept_unknown", "label": "Concept unknown", "studentPrompt": "I did not know the concept" },
    { "id": "cause.misread_question", "label": "Misread the question", "studentPrompt": "I misread the question" },
    { "id": "cause.calculation_slip", "label": "Calculation slip", "studentPrompt": "I made a calculation slip" },
    { "id": "cause.fell_for_trap", "label": "Fell for a trap", "studentPrompt": "I fell for a trap" },
    { "id": "cause.ran_out_of_time", "label": "Ran out of time", "studentPrompt": "I ran out of time" },
    { "id": "cause.guessed", "label": "Guessed", "studentPrompt": "I guessed" }
  ],
  "traps": [
    {
      "id": "trap.misread_question",
      "label": "Misread the question",
      "description": "The usual mark loss is answering a nearby question (who, when, before/after, which person) instead of the one that was asked.",
      "notebookCause": "cause.misread_question",
      "autoTagged": false
    },
    {
      "id": "trap.negation",
      "label": "Which is NOT / except",
      "description": "The stem asks for the false option, the exception, or the one that is NOT true. Students answer the true statement.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": true
    },
    {
      "id": "trap.keyword_lift",
      "label": "Keyword lift",
      "description": "A word or phrase copied from the passage or stem is a distractor. The item records that distractor as its trap.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": true
    },
    {
      "id": "trap.unit_conversion",
      "label": "Unit or conversion slip",
      "description": "Marks are lost by forgetting a unit, converting the wrong way, or mixing cm and m, g and kg, min and h, ml and l.",
      "notebookCause": "cause.calculation_slip",
      "autoTagged": false
    },
    {
      "id": "trap.multi_step_omission",
      "label": "Multi-step omission",
      "description": "A later step is dropped: the student stops after the first number that appears.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": false
    },
    {
      "id": "trap.diagram_misread",
      "label": "Diagram, table, or graph misread",
      "description": "The mark is lost on a figure, table, graph, or picture (wrong bar, wrong angle, wrong label) rather than on the calculation.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": false
    },
    {
      "id": "trap.lookalike",
      "label": "Lookalike form",
      "description": "Two forms look or sound alike: 形近字, 同音字, their/there, hear/here, its/it's, or a near number.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": true
    },
    {
      "id": "trap.sequence_order",
      "label": "Order swapped",
      "description": "Events, steps, or a sequence are put in the wrong order.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": true
    },
    {
      "id": "trap.rule_overgeneralise",
      "label": "Rule applied too widely",
      "description": "A real rule is used outside its condition (more bigger, double comparative, a spelling rule that does not fit this word).",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": true
    },
    {
      "id": "trap.literal_idiom",
      "label": "Idiom read word by word",
      "description": "A fixed expression or idiom is taken literally.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": true
    },
    {
      "id": "trap.extra_number",
      "label": "Unused number",
      "description": "A number printed in the question is not needed, and using it changes the answer.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": false
    },
    {
      "id": "trap.sign_direction",
      "label": "Sign or direction reversed",
      "description": "Increase/decrease, before/after a change, or the sign of a value is reversed.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": false
    },
    {
      "id": "trap.partial_answer",
      "label": "Partial answer",
      "description": "A two-part question is only half answered.",
      "notebookCause": "cause.fell_for_trap",
      "autoTagged": false
    }
  ],
